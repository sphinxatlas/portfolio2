---
import { Image } from 'astro:assets';
import type { Case } from '../lib/content';
import ConceptTag from './ConceptTag.astro';
import StatusLabel from './StatusLabel.astro';

interface Props {
  entry: Case;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel = 'h3' } = Astro.props;
const { data } = entry;
const Heading = headingLevel;
const href = `/work/${data.slug}`;
---

<article class="card group relative flex flex-col overflow-hidden">
  <Image
    src={data.heroImage}
    alt={data.heroAlt}
    widths={[480, 800, 1120]}
    sizes="(min-width: 768px) 540px, 100vw"
    class="aspect-[16/10] w-full border-b border-line object-cover"
  />
  <div class="flex flex-1 flex-col p-6">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
      {data.type === 'concept' && <ConceptTag label={data.conceptLabel} />}
      <StatusLabel status={data.status} />
    </div>
    <Heading class="type-h3 mt-4">{data.title}</Heading>
    <p class="mt-3 text-muted">{data.summary}</p>
    <ul class="mt-5 flex flex-wrap gap-2" aria-label="Tools">
      {data.stats.tools.slice(0, 3).map((tool) => <li class="chip">{tool}</li>)}
    </ul>
    <p class="mt-auto pt-6">
      <a
        href={href}
        class="inline-flex min-h-11 items-center font-medium after:absolute after:inset-0 after:content-['']"
        aria-label={`Read case: ${data.title}`}
      >
        Read case
      </a>
    </p>
  </div>
</article>
