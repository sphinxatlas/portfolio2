---
// Real numbers from real work. Only add items you can back up.
const items = [
  { value: '30k+', label: 'contacts in automated B2B email programs' },
  { value: '20+', label: 'congresses and KOL events delivered' },
  { value: '5', label: 'agencies managed' },
  { value: 'EU MDR', label: 'regulated claims review on marketing materials' },
];
---

<section class="border-t border-line" aria-labelledby="proof-title">
  <div class="container-page py-16 md:py-20">
    <h2 id="proof-title" class="sr-only">Proof from real work</h2>
    <span class="rule mb-10" aria-hidden="true"></span>
    <dl class="grid grid-cols-2 gap-x-6 gap-y-10 md:grid-cols-4">
      {
        items.map((item) => (
          <div class="flex flex-col-reverse justify-end gap-3">
            <dt class="max-w-[22ch] text-[15px] leading-6 text-muted">{item.label}</dt>
            <dd class="font-display text-[40px] leading-[44px] tracking-[-0.02em] md:text-[56px] md:leading-[60px]">
              {item.value}
            </dd>
          </div>
        ))
      }
    </dl>
    <p class="mt-10 text-[15px] leading-6 text-muted">At Phagenesis, a neurorehabilitation medtech company.</p>
  </div>
</section>
