---
const nav = [
  { href: '/work', label: 'Work' },
  { href: '/about', label: 'About' },
  { href: '/ai', label: 'AI' },
  { href: '/contact', label: 'Contact' },
];

const path = Astro.url.pathname.replace(/\/$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
const linkClass =
  'flex min-h-11 items-center text-[16px] text-ink no-underline decoration-accent underline-offset-[6px] hover:underline aria-[current=page]:underline';
---

<header class="border-b border-line">
  <div class="container-page flex min-h-[72px] items-center justify-between gap-6">
    <a href="/" class="flex min-h-11 items-center font-display text-[22px] leading-none tracking-[-0.01em] text-ink no-underline">
      Sophie Paulussen
    </a>

    <nav aria-label="Main" class="hidden md:block">
      <ul class="flex items-center gap-8">
        {
          nav.map((item) => (
            <li>
              <a href={item.href} class={linkClass} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <details class="disclosure relative md:hidden">
      <summary class="flex min-h-11 min-w-11 items-center justify-end gap-2 text-[16px]">
        Menu <span class="disclosure-marker" aria-hidden="true"></span>
      </summary>
      <nav aria-label="Main" class="card absolute top-full right-0 z-20 mt-2 w-56 px-4 py-2">
        <ul>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class={linkClass} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>
