---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="This page does not exist." ogSlug="404" noindex>
  <div class="container-page pt-16 md:pt-24">
    <p class="type-label text-muted">404</p>
    <h1 class="type-h1 mt-6">Page not found</h1>
    <p class="mt-6 max-w-[56ch] text-[19px] leading-[30px]">This page does not exist or has moved.</p>
    <div class="mt-10 flex flex-wrap gap-3">
      <a href="/" class="btn btn-primary">Go to the home page</a>
      <a href="/work" class="btn btn-secondary">See the work</a>
    </div>
  </div>
</BaseLayout>
